---
// Rozcestník příběhů
import Base from '../../layouts/Base.astro';
import { lineByK } from '../../lib/data.js';
import { pribehy } from '../../lib/pribehy.js';
---
<Base title="Příběhy">
  <h1>Příběhy</h1>
  <p class="lead">Vyprávění o předcích poskládané ze zápisů v matrikách, z rodinných dokumentů a vzpomínek.</p>
  <div class="pribehy-seznam">
    {pribehy.map((p) => {
      const line = lineByK[p.rod];
      return (
        <a class="card card-link pribeh-karta" style={line ? `--c:${line.color}` : ''} href={p.url}>
          <h2>{p.title}</h2>
          {p.lead && <p>{p.lead}</p>}
          <span class="btn">{p.tlacitko || 'Přečíst příběh'} →</span>
        </a>
      );
    })}
  </div>
</Base>
